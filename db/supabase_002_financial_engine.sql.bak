-- Align the schema with financial_engine's actual contracts.
-- Run after 001_schema.sql. Idempotent.
--
-- Storage pattern for engine output: keep the ENTIRE ForecastResult.to_dict() in one
-- jsonb column, and promote to real columns only what gets filtered, sorted or listed.
-- The algorithm is still moving; a fully normalised schema would need a migration for
-- every field the engine gains, while jsonb absorbs them for free. The promoted columns
-- are the ones that must stay queryable even if the payload shape changes.

-- ── forecast_runs: fit ForecastResult ────────────────────────────────────────
alter table forecast_runs add column if not exists result             jsonb;
alter table forecast_runs add column if not exists health_score       int;
alter table forecast_runs add column if not exists resilience_score   int;
alter table forecast_runs add column if not exists financing_status   text;
alter table forecast_runs add column if not exists breach_date        date;
alter table forecast_runs add column if not exists breach_shortfall   numeric(14,2);
alter table forecast_runs add column if not exists scenario           text not null default 'baseline';

-- 001 guessed at these two before the engine existed; `result` now holds both.
alter table forecast_runs drop column if exists curve;
alter table forecast_runs drop column if exists breach;

alter table forecast_runs drop constraint if exists forecast_runs_financing_status_check;
alter table forecast_runs add constraint forecast_runs_financing_status_check
  check (financing_status is null or financing_status in (
    'not_needed',
    'covered_by_recovery_plan',
    'recommended',
    'not_recommended_structural'
  ));

alter table forecast_runs drop constraint if exists forecast_runs_scores_check;
alter table forecast_runs add constraint forecast_runs_scores_check
  check (
    (health_score     is null or health_score     between 0 and 100)
    and (resilience_score is null or resilience_score between 0 and 100)
  );

-- A breach has both a date and a shortfall, or neither. Half a breach is a bug.
alter table forecast_runs drop constraint if exists forecast_runs_breach_paired;
alter table forecast_runs add constraint forecast_runs_breach_paired
  check ((breach_date is null) = (breach_shortfall is null));

-- A structural verdict must never arrive alongside a financing recommendation. This is
-- the product's central promise, so it is enforced in the database rather than left to
-- whichever caller writes the row.
alter table forecast_runs drop constraint if exists forecast_runs_structural_never_recommends;
alter table forecast_runs add constraint forecast_runs_structural_never_recommends
  check (not (verdict = 'structural' and financing_status = 'recommended'));

create index if not exists forecast_runs_breach_idx
  on forecast_runs (tenant_id, breach_date)
  where breach_date is not null;

-- ── obligations: fields the engine reads ─────────────────────────────────────
-- financial_engine.models.Obligation carries relationship_cost; the ladder ranks a
-- payable shift partly by it. Default 0 means "no evidence of cost", which pairs with
-- slack_days defaulting to 0 — no evidence of slack either.
alter table obligations add column if not exists relationship_cost numeric(14,2) not null default 0;

alter table obligations drop constraint if exists obligations_relationship_cost_nonneg;
alter table obligations add constraint obligations_relationship_cost_nonneg
  check (relationship_cost >= 0);

-- ── receivable collection behaviour ──────────────────────────────────────────
-- models.Receivable defaults collection_probability to 0.80 for everyone. We can do
-- better: `terms` already measures each counterparty's spread, and a client whose
-- payment lag swings 30 days does not deserve the same confidence as one that swings 2.
-- Stored as a view so the engine's input is derived, never hand-maintained.
-- security_invoker is mandatory here: without it a view runs with its OWNER's rights and
-- silently bypasses RLS on `terms`, exposing every tenant's payment history to any
-- caller. It does not error — it just returns other people's rows.
create or replace view receivable_confidence
with (security_invoker = true) as
select
  t.tenant_id,
  t.counterparty_rfc,
  t.days,
  t.spread,
  t.learned,
  case
    when not t.learned      then 0.70   -- cold start: no history, be conservative
    when t.spread <= 7      then 0.90   -- reliable payer
    when t.spread <= 21     then 0.80
    else                         0.60   -- erratic: the median date means little
  end as collection_probability
from terms t;

-- ── suppressions: tie to the engine's own verdict ────────────────────────────
alter table suppressions add column if not exists financing_status text;

comment on table suppressions is
  'Self-expiring credit suppression, written when a run returns '
  'financing_status = not_recommended_structural. Deliberately NOT a blacklist: '
  'it expires on its own and lifts when the verdict stops being structural. '
  'See CONCEPT.md section 7.';
